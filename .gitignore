# Added by Cargo - contains all compiled artifacts and binaries
/target/

# Backup files generated by rustfmt when formatting code
**/*.rs.bk

# MSVC Windows builds generate these files containing debugging info
*.pdb

# If rustc crashes, it dumps stack traces to these files
rustc-ice-*.txt

# Mutation testing data (if you use cargo-mutants)
**/mutants.out/
